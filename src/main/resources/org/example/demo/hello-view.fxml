<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<GridPane stylesheets="@my.css" fx:controller="org.example.demo.HelloController" xmlns:fx="http://javafx.com/fxml" alignment="center" hgap="10" vgap="10">

<VBox fx:id="scenePane" alignment="CENTER" prefHeight="600.0" prefWidth="600.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox minHeight="100.0" minWidth="600.0" prefHeight="100.0">
         <children>
            <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#openNewWindow" prefHeight="40.0" prefWidth="140.0" text="Добавити">
               <HBox.margin>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="btnEdit" mnemonicParsing="false" prefHeight="40.0" prefWidth="140.0" text="Редагувати ">
               <HBox.margin>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#new_Alert" prefHeight="40.0" prefWidth="140.0" text="Видалити">
               <HBox.margin>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <AnchorPane prefHeight="100.0" prefWidth="600.0">
         <VBox.margin>
            <Insets left="30.0" right="30.0" />
         </VBox.margin>
         <children>
            <TextField fx:id="txtSearch" layoutY="13.0" prefHeight="40.0" prefWidth="310.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="205.0" />
            <Button fx:id="btnSearch" layoutX="404.0" layoutY="13.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="140.0" text="Пошук" AnchorPane.rightAnchor="0.0" />
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="200.0" prefWidth="600.0">
         <children>
            <TableView fx:id="tableAddressBook" prefHeight="250.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
              <columns>
                <TableColumn fx:id="columPIB" prefWidth="250.0" text="ПІБ" />
                <TableColumn fx:id="columPhone" minWidth="0.0" prefWidth="250.0" text="Телефон" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <VBox.margin>
            <Insets left="30.0" right="30.0" />
         </VBox.margin>
      </AnchorPane>
      <AnchorPane prefHeight="100.0" prefWidth="600.0">
         <children>
            <Label fx:id="labelCount" layoutY="27.0" text="Кількість записів:" />
            <Label fx:id="label" layoutY="55.0" text="" />
         </children>
         <VBox.margin>
            <Insets left="30.0" right="30.0" />
         </VBox.margin>
      </AnchorPane>
   </children>
</VBox>
</GridPane>